{
  "expo": {
    "name": "Prexpire",
    "slug": "prexpire",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050D10",
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.prexpire.app"
    },
    "android": {
      "package": "com.prexpire.app"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Prexpire uses your camera to read expiry dates on packaging. Images are processed on your device and never uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-localization",
      "./plugins/withMlKitOcrModel"
    ]
  }
}
